{
  "$schema": "https://civitai.com/schemas/app-block/v1.json",
  "blockId": "model-benchmarking",
  "version": "0.2.0",
  "name": "Model Benchmarking",
  "type": "block",
  "category": "generation",
  "scopes": [
    "ai:write:budgeted",
    "buzz:read:self",
    "apps:storage:read",
    "apps:storage:write",
    "apps:storage:shared:read",
    "apps:storage:shared:write"
  ],
  "page": {
    "path": "/",
    "title": "Model Benchmarking",
    "icon": "chart-bar",
    "buzzBudgetPerGen": 1000
  },
  "iframe": {
    "minHeight": 640,
    "maxHeight": 4000,
    "resizable": true,
    "sandbox": "allow-scripts allow-forms"
  },
  "contentRating": "pg13",
  "minApiVersion": "1.0",
  "buildCommand": "npm run build",
  "outputDir": "dist"
}
